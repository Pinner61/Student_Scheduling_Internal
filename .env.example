# Copy this file to `.env.local` for local development.
# Never commit real secrets.

# Public application URL used for invitation, confirmation, and password-reset links.
# Local: http://localhost:3000
# Render also sets RENDER_EXTERNAL_URL automatically. NEXT_PUBLIC_APP_URL should still be set
# so invitation and reset links are correct.

# --- Development ---
# Seed-backed demo store. Safe for local work without Supabase.
NEXT_PUBLIC_DEMO_MODE=true

# Demo password login for seeded accounts. Off by default in production.
# Local without Supabase: leave true. Production: false.
ENABLE_DEMO_AUTH=true
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true

# Optional: show the demo role switcher outside development.
NEXT_PUBLIC_ENABLE_ROLE_SWITCHER=false

# Optional first administrator when no admin exists yet.
# The matching @asu.edu account is promoted server-side on registration/activation.
BOOTSTRAP_ADMIN_EMAIL=

# --- Test ---
# Use the same demo flags. Do not point tests at production data.

# --- Hosted review (Render) ---
# Keep the real Supabase variables. Also set these so seeded Student / Supervisor /
# Administrator accounts work for stakeholder review. Redeploy after changing
# NEXT_PUBLIC_* values; they are inlined at build time.
# ENABLE_DEMO_AUTH=true
# NEXT_PUBLIC_ENABLE_DEMO_AUTH=true
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_ENABLE_ROLE_SWITCHER=false

# --- Production / Render ---
# NEXT_PUBLIC_DEMO_MODE=false
# ENABLE_DEMO_AUTH=false
# NEXT_PUBLIC_ENABLE_DEMO_AUTH=false
# NEXT_PUBLIC_ENABLE_ROLE_SWITCHER=false
# Apply supabase/migrations, then provide:

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications stay disabled until a real provider is configured.
# The app will not claim that email was sent without credentials.
SMTP_URL=
RESEND_API_KEY=
EMAIL_FROM=

# ASU SSO is intentionally not implemented in this pass.
# See docs/authentication.md for the future identity-provider insertion point.
