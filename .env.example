# Copy this file to `.env.local` for local development.
# Never commit real secrets.

# Demo mode is used when Supabase is not configured.
NEXT_PUBLIC_DEMO_MODE=true

# Required only when connecting to a live Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: show the demo role switcher outside development.
NEXT_PUBLIC_ENABLE_ROLE_SWITCHER=false
