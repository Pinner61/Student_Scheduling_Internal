# Copy this file to `.env.local` for local development.
# Never commit real secrets.

# --- Development ---
# Seed-backed demo store and demo login. Safe for local work.
NEXT_PUBLIC_DEMO_MODE=true
ENABLE_DEMO_AUTH=true
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true

# Optional: show the demo role switcher outside development.
NEXT_PUBLIC_ENABLE_ROLE_SWITCHER=false

# --- Test ---
# Use the same demo flags. Do not point tests at production data.

# --- Production ---
# Set NEXT_PUBLIC_DEMO_MODE=false
# Set ENABLE_DEMO_AUTH=false
# Set NEXT_PUBLIC_ENABLE_DEMO_AUTH=false
# Set NEXT_PUBLIC_ENABLE_ROLE_SWITCHER=false
# Apply supabase/migrations, then provide:

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications stay disabled until a real provider is configured.
# The app will not claim that email was sent without credentials.
SMTP_URL=
RESEND_API_KEY=
EMAIL_FROM=

# ASU SSO is intentionally not implemented in this pass.
# See docs/authentication.md for the future identity-provider insertion point.
